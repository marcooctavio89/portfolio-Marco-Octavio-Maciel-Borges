---
// Contact.astro
---

<section id="contacto" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="space-y-3 mb-16 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 font-mono text-sm text-[#00ff66]">
        <span>06.</span>
        <span class="tracking-widest uppercase">Canal de Contacto</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
        Iniciemos una Conexión Segura
      </h2>
      <p class="text-slate-400 text-base sm:text-lg">
        ¿Tienes una propuesta laboral, proyecto de infraestructura o consulta de seguridad? Estoy disponible para incorporarme a equipos técnicos y proyectos desafiantes.
      </p>
    </div>

    <!-- Contact Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 max-w-5xl mx-auto">
      
      <!-- Direct Contact Methods (Left) -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- Email Card with 1-click copy -->
        <div class="p-6 rounded-2xl bg-[#111827] border border-[#1f293d] hover:border-[#00f0ff]/50 transition-all shadow-xl group">
          <div class="flex items-center justify-between mb-3">
            <span class="font-mono text-xs text-[#00f0ff] uppercase tracking-wider">CORREO ELECTRÓNICO</span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#00ff66] animate-pulse"></span>
          </div>
          <div class="text-slate-100 font-mono text-sm sm:text-base font-bold break-all mb-4">
            marcooctavio89@gmail.com
          </div>
          <div class="flex items-center gap-2">
            <a 
              href="mailto:marcooctavio89@gmail.com" 
              class="flex-1 text-center py-2 px-3 rounded-lg bg-[#00f0ff] text-[#0b0f19] font-mono text-xs font-bold hover:bg-cyan-300 transition-colors"
            >
              Enviar Email
            </a>
            <button 
              id="copy-email-btn"
              type="button" 
              class="py-2 px-3 rounded-lg bg-[#0b0f19] border border-[#1f293d] text-slate-300 hover:text-[#00ff66] hover:border-[#00ff66] font-mono text-xs transition-colors flex items-center gap-1.5"
              title="Copiar dirección"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"/></svg>
              <span id="copy-text">Copiar</span>
            </button>
          </div>
        </div>

        <!-- GitHub Profile Card -->
        <a 
          href="https://github.com/marcooctavio89" 
          target="_blank" 
          rel="noopener noreferrer"
          class="block p-6 rounded-2xl bg-[#111827] border border-[#1f293d] hover:border-[#00ff66]/50 transition-all shadow-xl group"
        >
          <div class="flex items-center justify-between mb-3">
            <span class="font-mono text-xs text-[#00ff66] uppercase tracking-wider">REPOSITORIO GITHUB</span>
            <span class="text-slate-400 group-hover:text-[#00ff66] transition-colors">↗</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-8 h-8 fill-current text-white group-hover:text-[#00ff66] transition-colors" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
            <div>
              <div class="text-white font-bold font-mono text-sm">github.com/marcooctavio89</div>
              <div class="text-slate-400 text-xs">Scripts en Python, configuraciones y proyectos ASIX</div>
            </div>
          </div>
        </a>

        <!-- LinkedIn Card -->
        <a 
          href="https://www.linkedin.com" 
          target="_blank" 
          rel="noopener noreferrer"
          class="block p-6 rounded-2xl bg-[#111827] border border-[#1f293d] hover:border-blue-500/50 transition-all shadow-xl group"
        >
          <div class="flex items-center justify-between mb-3">
            <span class="font-mono text-xs text-blue-400 uppercase tracking-wider">LINKEDIN PROFILE</span>
            <span class="text-slate-400 group-hover:text-blue-400 transition-colors">↗</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-8 h-8 fill-current text-blue-400" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            <div>
              <div class="text-white font-bold font-mono text-sm">Marco Octavio Maciel Borges</div>
              <div class="text-slate-400 text-xs">Conecta profesionalmente en LinkedIn</div>
            </div>
          </div>
        </a>

        <!-- Download CV Card -->
        <a 
          href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/Marco_Maciel_CV.pdf`} 
          download="Marco_Maciel_CV.pdf"
          class="block p-5 rounded-2xl bg-[#0b0f19] border border-[#00ff66]/40 hover:bg-[#00ff66]/10 hover:border-[#00ff66] transition-all group"
        >
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="p-2.5 rounded-lg bg-[#00ff66]/10 text-[#00ff66]">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
              </span>
              <div>
                <div class="text-[#00ff66] font-mono text-sm font-bold">Descargar Currículum (PDF)</div>
                <div class="text-slate-400 text-xs font-mono">Marco_Maciel_CV.pdf</div>
              </div>
            </div>
            <span class="text-[#00ff66] font-mono text-sm font-bold">↓</span>
          </div>
        </a>

      </div>

      <!-- Quick Message Form (Right) -->
      <div class="lg:col-span-7">
        <div class="rounded-2xl bg-[#111827] border border-[#1f293d] p-6 sm:p-8 shadow-2xl">
          <div class="flex items-center justify-between pb-4 mb-6 border-b border-[#1f293d]">
            <h3 class="text-lg font-bold text-white flex items-center gap-2">
              <span class="text-[#00f0ff] font-mono">&gt;</span> Redactar Mensaje Directo
            </h3>
            <span class="font-mono text-xs text-slate-500">MAILTO PROTOCOL</span>
          </div>

          <form id="contact-form" class="space-y-4">
            <div>
              <label for="sender-name" class="block font-mono text-xs text-slate-400 mb-1.5 uppercase">
                Tu Nombre o Empresa:
              </label>
              <input 
                type="text" 
                id="sender-name" 
                required 
                placeholder="Ej. Juan Pérez (Tech Corp)" 
                class="w-full px-4 py-2.5 rounded-lg bg-[#0b0f19] border border-[#1f293d] text-slate-200 text-sm focus:outline-none focus:border-[#00f0ff] font-mono"
              />
            </div>

            <div>
              <label for="sender-subject" class="block font-mono text-xs text-slate-400 mb-1.5 uppercase">
                Asunto:
              </label>
              <input 
                type="text" 
                id="sender-subject" 
                required 
                placeholder="Oportunidad Sysadmin / ASIX / Seguridad" 
                class="w-full px-4 py-2.5 rounded-lg bg-[#0b0f19] border border-[#1f293d] text-slate-200 text-sm focus:outline-none focus:border-[#00f0ff] font-mono"
              />
            </div>

            <div>
              <label for="sender-message" class="block font-mono text-xs text-slate-400 mb-1.5 uppercase">
                Mensaje:
              </label>
              <textarea 
                id="sender-message" 
                rows="4" 
                required 
                placeholder="Hola Marco, hemos revisado tu portfolio y nos gustaría hablar contigo sobre..." 
                class="w-full px-4 py-2.5 rounded-lg bg-[#0b0f19] border border-[#1f293d] text-slate-200 text-sm focus:outline-none focus:border-[#00f0ff] font-mono"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full py-3 px-6 rounded-lg bg-gradient-to-r from-[#00f0ff] to-[#00ff66] text-[#0b0f19] font-mono font-bold text-sm hover:opacity-95 transition-opacity shadow-lg shadow-[#00f0ff]/10 flex items-center justify-center gap-2"
            >
              <span>Generar y Enviar Correo</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // Copy Email handler
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-text');
  const emailToCopy = 'marcooctavio89@gmail.com';

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(emailToCopy);
      if (copyText) {
        copyText.textContent = '¡Copiado!';
        copyText.classList.add('text-[#00ff66]');
      }
      setTimeout(() => {
        if (copyText) {
          copyText.textContent = 'Copiar';
          copyText.classList.remove('text-[#00ff66]');
        }
      }, 2500);
    } catch {
      // Fallback
      window.prompt('Copia este correo:', emailToCopy);
    }
  });

  // Mailto Form handler
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  contactForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const name = (document.getElementById('sender-name') as HTMLInputElement)?.value || '';
    const subject = (document.getElementById('sender-subject') as HTMLInputElement)?.value || 'Contacto Profesional';
    const message = (document.getElementById('sender-message') as HTMLTextAreaElement)?.value || '';

    const bodyText = `Hola Marco,%0D%0A%0D%0A${encodeURIComponent(message)}%0D%0A%0D%0AAtentamente,%0D%0A${encodeURIComponent(name)}`;
    const mailtoUrl = `mailto:marcooctavio89@gmail.com?subject=${encodeURIComponent(subject)}&body=${bodyText}`;
    
    window.location.href = mailtoUrl;
  });
</script>

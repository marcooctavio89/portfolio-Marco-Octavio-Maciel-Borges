---
// Terminal.astro
---

<section id="terminal" class="py-20 relative">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="space-y-3 mb-10 text-center sm:text-left">
      <div class="flex items-center justify-center sm:justify-start gap-2 font-mono text-sm text-[#00ff66]">
        <span>04.</span>
        <span class="tracking-widest uppercase">Consola Interactiva</span>
        <div class="hidden sm:block h-px bg-[#1f293d] flex-1 max-w-xs"></div>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Terminal de Diagnóstico & Comandos
      </h2>
      <p class="text-slate-400 max-w-2xl text-sm sm:text-base">
        Emulador de consola bash para inspeccionar el perfil de Marco Octavio Maciel Borges directamente desde la línea de comandos.
      </p>
    </div>

    <!-- Terminal Container -->
    <div class="rounded-2xl bg-[#070a12] border border-[#1f293d] shadow-2xl overflow-hidden font-mono text-xs sm:text-sm glow-cyan">
      
      <!-- Terminal Top Bar -->
      <div class="bg-[#111827] px-4 py-3 border-b border-[#1f293d] flex items-center justify-between select-none">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block cursor-pointer hover:opacity-100 transition-opacity" title="Cerrar"></span>
          <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block cursor-pointer hover:opacity-100 transition-opacity" title="Minimizar"></span>
          <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block cursor-pointer hover:opacity-100 transition-opacity" title="Maximizar"></span>
          <span class="ml-3 text-slate-400 text-xs hidden sm:inline">bash — marco@portfolio-secops: ~/terminal (tty1)</span>
        </div>
        <div class="flex items-center gap-2 text-[11px] text-slate-500">
          <span class="w-2 h-2 rounded-full bg-[#00ff66] animate-pulse"></span>
          <span>SSH-2.0-OpenSSH_9.6</span>
        </div>
      </div>

      <!-- Terminal Output Screen -->
      <div id="terminal-screen" class="p-4 sm:p-6 min-h-[340px] max-h-[520px] overflow-y-auto space-y-3 text-slate-300">
        
        <!-- Welcome ASCII & Banner -->
        <div class="text-[#00f0ff] font-bold text-xs sm:text-sm whitespace-pre leading-tight">
  __  __                  __  __            _      _ 
 |  \/  |__ _ _ _ __ ___ |  \/  |__ _ __ _ (_)___ | |
 | |\/| / _` | '_/ _/ _ \| |\/| / _` / _| || / -_)| |
 |_|  |_\__,_|_| \__\___/|_|  |_\__,_\__|_|/_\___||_|
        </div>

        <div class="text-slate-400 text-xs space-y-1 pt-1 pb-2 border-b border-[#1f293d]/60">
          <p><span class="text-[#00ff66]">● SEC-OPS HOST:</span> portfolio.marco-maciel.internal</p>
          <p><span class="text-[#00f0ff]">● KERNEL:</span> Linux 6.8.0-sysadmin-asix x86_64</p>
          <p class="text-slate-300">
            Escribe <span class="text-[#00ff66] font-bold">help</span> para consultar los comandos disponibles o utiliza los botones de acceso rápido inferiores.
          </p>
        </div>

        <!-- Dynamic Output Stream -->
        <div id="terminal-output" class="space-y-3"></div>

        <!-- Current Command Input Line -->
        <form id="terminal-form" class="flex items-center gap-2 pt-1" autocomplete="off">
          <span class="text-[#00ff66] font-semibold flex-shrink-0">marco@secops:~$</span>
          <input 
            type="text" 
            id="terminal-input" 
            class="flex-1 bg-transparent text-[#00f0ff] focus:outline-none font-mono text-xs sm:text-sm caret-[#00f0ff] border-none p-0"
            placeholder="escribe un comando (ej: help, whoami, skills)..."
            spellcheck="false"
            autocorrect="off"
            autocapitalize="off"
          />
        </form>

      </div>

      <!-- Quick Command Buttons Bar -->
      <div class="bg-[#0b0f19] px-4 py-3 border-t border-[#1f293d] flex flex-wrap items-center gap-2 text-xs">
        <span class="text-slate-500 font-mono text-[11px] mr-1 hidden sm:inline">Accesos directos:</span>
        <button type="button" class="cmd-chip px-2.5 py-1 rounded bg-[#111827] border border-[#1f293d] hover:border-[#00ff66] hover:text-[#00ff66] text-slate-300 font-mono transition-colors" data-cmd="help">
          help
        </button>
        <button type="button" class="cmd-chip px-2.5 py-1 rounded bg-[#111827] border border-[#1f293d] hover:border-[#00f0ff] hover:text-[#00f0ff] text-slate-300 font-mono transition-colors" data-cmd="whoami">
          whoami
        </button>
        <button type="button" class="cmd-chip px-2.5 py-1 rounded bg-[#111827] border border-[#1f293d] hover:border-[#00f0ff] hover:text-[#00f0ff] text-slate-300 font-mono transition-colors" data-cmd="skills">
          skills
        </button>
        <button type="button" class="cmd-chip px-2.5 py-1 rounded bg-[#111827] border border-[#1f293d] hover:border-[#00f0ff] hover:text-[#00f0ff] text-slate-300 font-mono transition-colors" data-cmd="projects">
          projects
        </button>
        <button type="button" class="cmd-chip px-2.5 py-1 rounded bg-[#111827] border border-[#1f293d] hover:border-[#00f0ff] hover:text-[#00f0ff] text-slate-300 font-mono transition-colors" data-cmd="languages">
          languages
        </button>
        <button type="button" class="cmd-chip px-2.5 py-1 rounded bg-[#111827] border border-[#1f293d] hover:border-[#00f0ff] hover:text-[#00f0ff] text-slate-300 font-mono transition-colors" data-cmd="contact">
          contact
        </button>
        <button type="button" class="cmd-chip px-2.5 py-1 rounded bg-[#111827] border border-[#1f293d] hover:border-[#00ff66] hover:text-[#00ff66] text-slate-300 font-mono transition-colors" data-cmd="github">
          github
        </button>
        <button type="button" class="cmd-chip px-2.5 py-1 rounded bg-[#111827] border border-[#1f293d] hover:border-red-400 hover:text-red-400 text-slate-400 font-mono transition-colors ml-auto" data-cmd="clear">
          clear
        </button>
      </div>

    </div>

  </div>
</section>

<!-- Terminal Logic Client Script -->
<script>
  const terminalForm = document.getElementById('terminal-form') as HTMLFormElement | null;
  const terminalInput = document.getElementById('terminal-input') as HTMLInputElement | null;
  const terminalOutput = document.getElementById('terminal-output');
  const terminalScreen = document.getElementById('terminal-screen');
  const cmdChips = document.querySelectorAll('.cmd-chip');

  const history: string[] = [];
  let historyIndex = -1;

  const commands: Record<string, string | (() => string)> = {
    help: `
<div class="text-[#00ff66] font-bold mb-1">COMANDOS DISPONIBLES:</div>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-xs">
  <div><span class="text-[#00f0ff] font-bold">whoami</span>      - Resumen del perfil profesional</div>
  <div><span class="text-[#00f0ff] font-bold">skills</span>      - Matriz de habilidades técnicas</div>
  <div><span class="text-[#00f0ff] font-bold">projects</span>    - Casos prácticos y auditorías</div>
  <div><span class="text-[#00f0ff] font-bold">languages</span>   - Idiomas y niveles</div>
  <div><span class="text-[#00f0ff] font-bold">contact</span>     - Canales de contacto y redes</div>
  <div><span class="text-[#00f0ff] font-bold">github</span>      - Abre el repositorio GitHub en nueva pestaña</div>
  <div><span class="text-[#00f0ff] font-bold">cv</span>          - Descarga el currículum en PDF</div>
  <div><span class="text-[#00f0ff] font-bold">status</span>      - Diagnóstico y telemetría de servicios</div>
  <div><span class="text-[#00f0ff] font-bold">clear</span>       - Limpia la pantalla de la terminal</div>
</div>
`,

    whoami: `
<div class="p-2 rounded bg-[#0b0f19] border border-[#1f293d] space-y-1">
  <div class="text-white font-bold text-sm">Marco Octavio Maciel Borges</div>
  <div class="text-[#00ff66]">Técnico en Administración de Sistemas, Redes y Ciberseguridad (ASIX)</div>
  <div class="text-slate-400 text-xs leading-relaxed">
    Especialista en infraestructura Linux/Windows Server, auditoría forense con Wireshark, monitorización centralizada con pila ELK y automatización mediante scripts en Python y Bash.
  </div>
</div>
`,

    skills: `
<div class="space-y-2 text-xs">
  <div><span class="text-[#00f0ff] font-bold">SISTEMAS & REDES:</span> Linux (Ubuntu Server, LVM, Bash), Windows Server (Active Directory, GPO, FSMO, Samba AD), DNS (BIND9).</div>
  <div><span class="text-[#00ff66] font-bold">CIBERSEGURIDAD:</span> Wireshark (análisis paquetes), Nmap, Metasploitable, scripts de auditoría en Python, Hardening (SSH, UFW, Iptables).</div>
  <div><span class="text-purple-400 font-bold">MONITORIZACIÓN / SIEM:</span> Pila ELK (Elasticsearch 8, Kibana Dashboards, agentes Winlogbeat).</div>
  <div><span class="text-amber-400 font-bold">DESARROLLO & BD:</span> Python (automatización), PHP, MySQL, Apache, HTML5/CSS3, Git.</div>
</div>
`,

    projects: `
<div class="space-y-2 text-xs">
  <div><span class="text-[#00ff66] font-bold">1. Script Auditoría SSH (auth.log):</span> Detección de ataques de fuerza bruta y parsing forense con Python. <a href="https://github.com/marcooctavio89" target="_blank" class="text-[#00f0ff] underline">github.com/marcooctavio89</a></div>
  <div><span class="text-[#00f0ff] font-bold">2. Análisis Tráfico Red:</span> Laboratorio con Wireshark sobre servicios FTP/Web en entorno Metasploitable.</div>
  <div><span class="text-purple-400 font-bold">3. Infraestructura Active Directory & Samba AD:</span> Despliegue de controladores de dominio, auditoría GPO y roles FSMO.</div>
  <div><span class="text-amber-400 font-bold">4. Entorno SIEM Centralizado:</span> Ingesta de eventos con Elasticsearch 8, Kibana y Winlogbeat en Ubuntu.</div>
</div>
`,

    languages: `
<div class="text-xs space-y-1">
  <div>🇪🇸 <span class="font-bold text-white">Español:</span> <span class="text-[#00ff66]">Nativo</span></div>
  <div>🏴󠁥󠁳󠁣󠁴󠁿 <span class="font-bold text-white">Catalán:</span> <span class="text-[#00ff66]">Nativo</span></div>
  <div>🇵🇹 <span class="font-bold text-white">Portugués:</span> <span class="text-[#00ff66]">Nativo</span></div>
  <div>🇬🇧 <span class="font-bold text-white">Inglés:</span> <span class="text-[#00f0ff] font-semibold">B2 (Competencia Profesional)</span></div>
</div>
`,

    contact: `
<div class="text-xs space-y-1">
  <div>📧 <span class="text-slate-400">Email:</span> <a href="mailto:marcooctavio89@gmail.com" class="text-[#00f0ff] hover:underline font-bold">marcooctavio89@gmail.com</a></div>
  <div>🐙 <span class="text-slate-400">GitHub:</span> <a href="https://github.com/marcooctavio89" target="_blank" class="text-[#00ff66] hover:underline">https://github.com/marcooctavio89</a></div>
  <div>💼 <span class="text-slate-400">Perfil:</span> Administrador de Sistemas, Redes y Ciberseguridad</div>
</div>
`,

    status: `
<div class="font-mono text-xs space-y-1 text-slate-300">
  <div>[SYSTEM] Node Status: <span class="text-[#00ff66] font-bold">HEALTHY / ALL SERVICES UP</span></div>
  <div>[SYSADMIN] Linux / Windows Server Domain: <span class="text-[#00f0ff]">SYNCHRONIZED</span></div>
  <div>[SECURITY] IDS/IPS & Log Parser: <span class="text-[#00ff66]">MONITORING</span></div>
  <div>[SIEM] Elasticsearch Cluster: <span class="text-amber-400">STATUS GREEN (3 NODES)</span></div>
</div>
`,

    github: () => {
      window.open('https://github.com/marcooctavio89', '_blank');
      return `<span class="text-[#00f0ff]">Redirigiendo a https://github.com/marcooctavio89 en una nueva pestaña...</span>`;
    },

    cv: () => {
      const link = document.createElement('a');
      link.href = '/Marco_Maciel_CV.pdf';
      link.download = 'Marco_Maciel_CV.pdf';
      link.click();
      return `<span class="text-[#00ff66]">Descargando /Marco_Maciel_CV.pdf...</span>`;
    },

    sudo: `
<div class="text-red-400 font-bold text-xs">
  [SECURITY ALERT] marco is not in the sudoers file. This incident will be reported to root.
</div>
`,

    clear: () => {
      if (terminalOutput) terminalOutput.innerHTML = '';
      return '';
    }
  };

  function executeCommand(rawCmd: string) {
    const cmd = rawCmd.trim().toLowerCase();
    if (!cmd) return;

    history.push(rawCmd);
    historyIndex = history.length;

    // Render user command line
    const userLine = document.createElement('div');
    userLine.className = 'flex items-center gap-2 text-slate-400';
    userLine.innerHTML = `<span class="text-[#00ff66] font-bold">marco@secops:~$</span> <span class="text-white">${rawCmd}</span>`;
    terminalOutput?.appendChild(userLine);

    // Process output
    const responseDiv = document.createElement('div');
    responseDiv.className = 'text-xs text-slate-300 pl-4 py-1';

    if (cmd === 'clear') {
      commands.clear();
      if (terminalScreen) terminalScreen.scrollTop = terminalScreen.scrollHeight;
      return;
    }

    if (cmd in commands) {
      const result = commands[cmd];
      responseDiv.innerHTML = typeof result === 'function' ? result() : result;
    } else {
      responseDiv.innerHTML = `
        <span class="text-red-400 font-mono">bash: comando no encontrado: ${rawCmd}</span>. 
        Escribe <span class="text-[#00ff66] underline cursor-pointer" onclick="document.querySelector('[data-cmd=help]')?.dispatchEvent(new Event('click'))">help</span> para consultar los comandos válidos.
      `;
    }

    terminalOutput?.appendChild(responseDiv);

    if (terminalScreen) {
      terminalScreen.scrollTop = terminalScreen.scrollHeight;
    }
  }

  // Handle Form Submit
  terminalForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!terminalInput) return;
    executeCommand(terminalInput.value);
    terminalInput.value = '';
  });

  // Handle Arrow Up / Down History
  terminalInput?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (history.length > 0 && historyIndex > 0) {
        historyIndex--;
        terminalInput.value = history[historyIndex];
      }
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (historyIndex < history.length - 1) {
        historyIndex++;
        terminalInput.value = history[historyIndex];
      } else {
        historyIndex = history.length;
        terminalInput.value = '';
      }
    }
  });

  // Handle Chips Click
  cmdChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const cmd = chip.getAttribute('data-cmd');
      if (cmd) {
        executeCommand(cmd);
        if (terminalInput) terminalInput.focus();
      }
    });
  });
</script>

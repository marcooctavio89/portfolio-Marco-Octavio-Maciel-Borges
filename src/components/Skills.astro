---
// Skills.astro — Light design with turquoise accents and progress indicators
const skillCategories = [
  {
    id: "systems-networks",
    title: "Sistemas & Redes",
    icon: "server",
    color: "#0891b2",
    colorBg: "#ecfeff",
    badge: "INFRAESTRUCTURA",
    description: "Administración, configuración avanzada, servicios de red y gestión de identidades en entornos corporativos híbridos.",
    skills: [
      { name: "GNU/Linux (Ubuntu Server)", level: "Avanzado", percent: "90", tags: ["Kernel", "CLI", "Systemd"] },
      { name: "Gestión de Almacenamiento (LVM)", level: "Avanzado", percent: "85", tags: ["Particionado", "Volúmenes", "Snapshots"] },
      { name: "Bash Scripting & Automatización", level: "Avanzado", percent: "88", tags: ["Crontab", "Backups", "Pipelines"] },
      { name: "Servicios de Red & DNS (BIND9)", level: "Sólido", percent: "80", tags: ["DNS", "DHCP", "Enrutamiento"] },
      { name: "Windows Server (2019/2022)", level: "Avanzado", percent: "87", tags: ["Active Directory", "Dominio"] },
      { name: "Directivas de Grupo (GPO)", level: "Avanzado", percent: "85", tags: ["Hardening", "Auditoría", "Despliegue"] },
      { name: "Roles FSMO & Controladores de Dominio", level: "Sólido", percent: "78", tags: ["Replicación", "Esquema"] },
      { name: "Samba 4 Active Directory", level: "Sólido", percent: "75", tags: ["Interoperabilidad", "Linux/Windows"] }
    ]
  },
  {
    id: "cybersecurity",
    title: "Ciberseguridad & Análisis",
    icon: "shield",
    color: "#0d9488",
    colorBg: "#f0fdfa",
    badge: "DEFENSA & AUDITORÍA",
    description: "Inspección forense de tráfico, análisis de vectores de ataque, escaneo de vulnerabilidades y hardening de sistemas.",
    skills: [
      { name: "Wireshark (Inspección de Paquetes)", level: "Avanzado", percent: "92", tags: ["PCAP", "TCP/IP", "Filtros BPF"] },
      { name: "Nmap Network Scanner", level: "Avanzado", percent: "88", tags: ["Descubrimiento", "NSE Scripts", "Puertos"] },
      { name: "Metasploitable Lab", level: "Sólido", percent: "75", tags: ["Pentesting", "Auditoría de Servicios", "CVEs"] },
      { name: "Scripts de Auditoría en Python", level: "Avanzado", percent: "85", tags: ["Log Parsing", "Regex", "Automatización"] },
      { name: "Hardening de Servidores (SSH, UFW, Iptables)", level: "Avanzado", percent: "90", tags: ["Seguridad Perimetral", "Fail2ban"] },
      { name: "Análisis Forense de Logs (auth.log, syslog)", level: "Avanzado", percent: "87", tags: ["Fuerza Bruta", "Detección"] }
    ]
  },
  {
    id: "monitoring-siem",
    title: "Monitorización & SIEM",
    icon: "chart",
    color: "#0284c7",
    colorBg: "#f0f9ff",
    badge: "VISIBILIDAD",
    description: "Recolección centralizada, ingesta masiva de registros, telemetría y cuadros de mando interactivos para alerta temprana.",
    skills: [
      { name: "Elasticsearch 8", level: "Sólido", percent: "78", tags: ["Índices", "Consultas KQL", "Clustering"] },
      { name: "Kibana Dashboards", level: "Sólido", percent: "76", tags: ["Visualizaciones", "Mapas", "Alertas"] },
      { name: "Agentes Winlogbeat", level: "Sólido", percent: "74", tags: ["Event Logs", "Windows Security", "Sysmon"] },
      { name: "Logstash / Beats Pipeline", level: "Intermedio", percent: "65", tags: ["Filtros Grok", "Transformación"] },
      { name: "Centralización de Eventos en Ubuntu", level: "Avanzado", percent: "85", tags: ["Syslog-ng", "Rsyslog", "Alertas"] }
    ]
  },
  {
    id: "dev-databases",
    title: "Desarrollo & Bases de Datos",
    icon: "code",
    color: "#d97706",
    colorBg: "#fffbeb",
    badge: "AUTOMATIZACIÓN",
    description: "Creación de herramientas a medida, scripts de soporte operativo y gestión de servicios web y bases de datos relacionales.",
    skills: [
      { name: "Python", level: "Avanzado", percent: "88", tags: ["Scripts Operativos", "Regex", "Manipulación de Datos"] },
      { name: "PHP", level: "Intermedio", percent: "60", tags: ["Backend", "Integración Web", "APIs"] },
      { name: "MySQL / MariaDB", level: "Sólido", percent: "78", tags: ["Consultas SQL", "Administración", "Backups"] },
      { name: "Servidor Web Apache & Nginx", level: "Sólido", percent: "80", tags: ["Virtual Hosts", "SSL/TLS", "Reverse Proxy"] },
      { name: "HTML5 & CSS3 / Modern Web", level: "Sólido", percent: "75", tags: ["Tailwind CSS", "Responsive UI"] },
      { name: "Control de Versiones Git & GitHub", level: "Avanzado", percent: "90", tags: ["Git CLI", "Repositorios", "CI/CD"] }
    ]
  }
];

const languages = [
  { lang: "Español", level: "Nativo / C2", percent: "100%" },
  { lang: "Catalán", level: "Nativo / C2", percent: "100%" },
  { lang: "Portugués", level: "Nativo / C2", percent: "100%" },
  { lang: "Inglés", level: "Intermedio B2", percent: "75%" }
];
---

<section id="habilidades" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="space-y-3 mb-16">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-cyan-500 to-teal-400 flex items-center justify-center shadow-md shadow-cyan-500/20">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <div>
          <span class="text-xs font-semibold text-cyan-600 uppercase tracking-wider">Competencias Técnicas</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
            Matriz de Especialización
          </h2>
        </div>
      </div>
      <p class="text-slate-500 max-w-2xl text-base sm:text-lg ml-[52px]">
        Conjunto de herramientas, protocolos y tecnologías aplicadas en la administración de infraestructuras críticas y auditoría de seguridad.
      </p>
    </div>

    <!-- Skills Matrix Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {skillCategories.map((category) => (
        <div class="rounded-2xl bg-white border border-slate-200 p-6 lg:p-7 hover:shadow-xl hover:shadow-slate-100 transition-all duration-300 relative group flex flex-col justify-between shadow-sm">
          
          <!-- Top Badge & Title -->
          <div>
            <div class="flex items-center justify-between mb-4">
              <span 
                class="text-xs font-semibold px-3 py-1 rounded-full" 
                style={`color: ${category.color}; background-color: ${category.colorBg};`}
              >
                {category.badge}
              </span>
            </div>

            <h3 class="text-xl font-bold text-slate-800 mb-2">
              {category.title}
            </h3>
            <p class="text-slate-500 text-sm mb-6 leading-relaxed">
              {category.description}
            </p>

            <!-- Skills List with Progress Bars -->
            <div class="space-y-3">
              {category.skills.map((skill) => (
                <div class="p-3 rounded-xl bg-slate-50/80 border border-slate-100 hover:bg-white hover:border-slate-200 transition-colors">
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-sm font-semibold text-slate-700">{skill.name}</span>
                    <span 
                      class="text-xs font-medium px-2 py-0.5 rounded-full"
                      style={`color: ${category.color}; background-color: ${category.colorBg};`}
                    >
                      {skill.level}
                    </span>
                  </div>
                  <!-- Progress bar -->
                  <div class="w-full bg-slate-200/60 h-1.5 rounded-full overflow-hidden mb-2">
                    <div 
                      class="h-full rounded-full transition-all duration-1000"
                      style={`width: ${skill.percent}%; background: linear-gradient(90deg, ${category.color}, ${category.color}bb);`}
                    ></div>
                  </div>
                  <div class="flex flex-wrap gap-1.5">
                    {skill.tags.map((tag) => (
                      <span class="text-[11px] font-medium text-slate-500 bg-white border border-slate-200 px-2 py-0.5 rounded-full">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Languages Subsection -->
    <div class="mt-12 p-6 sm:p-8 rounded-2xl bg-white border border-slate-200 shadow-sm relative overflow-hidden">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-6">
        <div>
          <span class="text-xs font-semibold text-cyan-600 uppercase tracking-wider">Comunicación Global</span>
          <h3 class="text-xl font-bold text-slate-800 mt-1">Competencias Lingüísticas</h3>
          <p class="text-slate-500 text-sm mt-1">Capacidad demostrada para trabajar y documentar en equipos multiculturales y entornos técnicos internacionales.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {languages.map((item) => (
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 hover:bg-cyan-50/50 hover:border-cyan-200 transition-all">
            <div class="flex items-center justify-between mb-2">
              <span class="font-bold text-slate-800 text-base">{item.lang}</span>
              <span class="font-mono text-xs text-cyan-600 font-bold">{item.percent}</span>
            </div>
            <div class="text-xs text-slate-500 mt-0.5 font-medium">{item.level}</div>
            <!-- Progress bar -->
            <div class="w-full bg-slate-200/60 h-1.5 rounded-full mt-3 overflow-hidden">
              <div 
                class="bg-gradient-to-r from-cyan-500 to-teal-400 h-full rounded-full" 
                style={`width: ${item.percent};`}
              ></div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

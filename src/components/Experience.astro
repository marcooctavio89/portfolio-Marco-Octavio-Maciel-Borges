---
// Experience.astro — Light design with turquoise accents
const experiences = [
  {
    type: "EXPERIENCIA LABORAL",
    role: "Técnico de Soporte Informático (Prácticas FCT)",
    organization: "Fundació Pere Tarrés",
    period: "Prácticas Formativas FCT",
    location: "Barcelona, España",
    badgeColor: "#0d9488",
    badgeBg: "#f0fdfa",
    summary: "Atención técnica integral a usuarios, resolución de incidencias en puestos de trabajo, mantenimiento preventivo de infraestructura y configuración de redes locales.",
    tasks: [
      "Soporte informático a usuarios de nivel 1 y 2 (hardware, periféricos, sistemas operativos Windows/Linux y aplicaciones).",
      "Instalación, clonación y configuración de nuevos puestos de trabajo y perfiles corporativos.",
      "Diagnóstico y resolución de incidencias en redes de área local (LAN), cableado estructurado y conectividad Wi-Fi.",
      "Gestión de accesos, inventario de equipamiento informático y documentación técnica de incidencias."
    ],
    tech: ["Soporte Nivel 1/2", "Windows 10/11", "GNU/Linux", "Redes LAN", "Hardware", "Gestión de Incidencias"]
  },
  {
    type: "EDUCACIÓN SUPERIOR",
    role: "Ciclo Formativo de Grado Superior en Administración de Sistemas Informáticos en Red (ASIX)",
    organization: "Digitech",
    period: "En curso",
    location: "Barcelona, España",
    badgeColor: "#0891b2",
    badgeBg: "#ecfeff",
    summary: "Formación especializada en la administración, securización y optimización de redes, servidores empresariales y servicios de telecomunicaciones.",
    tasks: [
      "Administración avanzada de servidores Linux (Ubuntu Server, Debian) y Windows Server (AD DS, GPOs).",
      "Diseño y despliegue de infraestructuras de red: conmutación, enrutamiento, VLANs, subnetting, DHCP y DNS con BIND9.",
      "Seguridad perimetral y hardening: cortafuegos (iptables/UFW), inspección de tráfico con Wireshark y escaneo con Nmap.",
      "Implantación de servicios de red, servidores web y virtualización con entornos tipo VMware/Proxmox.",
      "Automatización de tareas de administración mediante scripting en Bash y scripts aplicados en Python."
    ],
    tech: ["ASIX", "Linux Server", "Windows Server AD", "VLANs", "Wireshark", "Bash Scripting", "Python", "Proxmox"]
  },
  {
    type: "FORMACIÓN PROFESIONAL",
    role: "Ciclo Formativo de Grado Medio en Sistemas Microinformáticos y Redes (SMR)",
    organization: "Salesians Sarrià",
    period: "Sep 2023 – Jun 2025",
    location: "Barcelona, España",
    badgeColor: "#0284c7",
    badgeBg: "#f0f9ff",
    summary: "Formación técnica intensiva en montaje, diagnóstico y mantenimiento de hardware, despliegue de redes de área local y administración básica de sistemas cliente.",
    tasks: [
      "Montaje, ensamblaje y verificación de equipos informáticos en banco de pruebas con diagnóstico y sustitución de hardware.",
      "Instalación, particionado y securización de sistemas operativos clientes Windows 10/11 y GNU/Linux (Ubuntu/Debian).",
      "Confección, conexión y certificación de cableado estructurado RJ-45 (T568A/B), configuración de switches y routers locales.",
      "Implementación de servidores de ficheros compartidos (Samba), copias de seguridad de datos y clonación de imágenes con Clonezilla.",
      "Despliegue y soporte técnico a aplicaciones web (CMS), suites ofimáticas y atención a incidencias de usuarios finales."
    ],
    tech: ["SMR", "Montaje Hardware", "Windows 10/11", "Ubuntu/Debian", "Cableado RJ-45", "Samba", "Clonezilla", "Redes Locales"]
  }
];
---

<section id="experiencia" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="space-y-3 mb-16">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-sky-500 to-cyan-400 flex items-center justify-center shadow-md shadow-sky-500/20">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <div>
          <span class="text-xs font-semibold text-sky-600 uppercase tracking-wider">Trayectoria Profesional</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
            Experiencia & Formación
          </h2>
        </div>
      </div>
      <p class="text-slate-500 max-w-2xl text-base sm:text-lg ml-[52px]">
        Evolución técnica desde la formación académica superior en ASIX hasta la práctica operativa en soporte de infraestructuras.
      </p>
    </div>

    <!-- Timeline Layout -->
    <div class="space-y-6">
      {experiences.map((item, index) => (
        <div class="relative flex gap-6 items-start">
          
          <!-- Timeline Left Indicator -->
          <div class="hidden md:flex flex-col items-center gap-0 flex-shrink-0">
            <div class="w-10 h-10 rounded-full bg-white border-2 border-slate-200 flex items-center justify-center shadow-sm group-hover:border-cyan-400 transition-colors">
              <span class="w-3 h-3 rounded-full" style={`background-color: ${item.badgeColor};`}></span>
            </div>
            {index < experiences.length - 1 && (
              <div class="w-0.5 h-full min-h-[40px] bg-slate-200"></div>
            )}
          </div>

          <!-- Card Content -->
          <div class="w-full rounded-2xl bg-white border border-slate-200 p-6 sm:p-7 hover:shadow-lg hover:shadow-slate-100 transition-all duration-300 shadow-sm group">
            
            <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
              <span 
                class="text-xs font-semibold px-3 py-1 rounded-full"
                style={`color: ${item.badgeColor}; background-color: ${item.badgeBg};`}
              >
                {item.type}
              </span>
              <span class="text-xs text-slate-400 font-medium">{item.period}</span>
            </div>

            <h3 class="text-xl font-bold text-slate-800 group-hover:text-cyan-600 transition-colors">
              {item.role}
            </h3>

            <div class="flex items-center gap-2 text-xs text-slate-500 mt-1 mb-4 font-medium">
              <span class="text-slate-700">{item.organization}</span>
              <span>•</span>
              <span>{item.location}</span>
            </div>

            <p class="text-slate-600 text-sm leading-relaxed mb-4">
              {item.summary}
            </p>

            <!-- Responsibilities / Learnings -->
            <ul class="space-y-2 text-xs text-slate-500 mb-6">
              {item.tasks.map((task) => (
                <li class="flex items-start gap-2">
                  <span class="text-cyan-500 font-bold mt-0.5">›</span>
                  <span>{task}</span>
                </li>
              ))}
            </ul>

            <!-- Tech badges -->
            <div class="pt-4 border-t border-slate-100 flex flex-wrap gap-1.5">
              {item.tech.map((t) => (
                <span class="text-[11px] font-medium px-2.5 py-1 rounded-full bg-slate-50 border border-slate-200 text-slate-500">
                  {t}
                </span>
              ))}
            </div>

          </div>

        </div>
      ))}
    </div>

  </div>
</section>

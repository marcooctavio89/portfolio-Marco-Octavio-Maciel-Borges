---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Marco Octavio Maciel Borges | Administrador de Sistemas, Redes y Ciberseguridad (ASIX)",
  description = "Portfolio profesional de Marco Octavio Maciel Borges - Especialista en Administración de Sistemas Linux/Windows, Redes, Hardening, SIEM y Ciberseguridad."
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Marco Octavio Maciel Borges" />
    <meta name="keywords" content="Marco Octavio Maciel Borges, Administrador de Sistemas, ASIX, Ciberseguridad, Redes, Linux, Windows Server, Active Directory, Wireshark, SIEM, ELK, Python, Bash" />

    <!-- Open Graph / LinkedIn / GitHub -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://github.com/marcooctavio89" />

    <!-- Google Fonts: JetBrains Mono & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#0b0f19] text-slate-200 min-h-screen flex flex-col font-sans selection:bg-[#00f0ff]/20 selection:text-[#00f0ff] relative cyber-grid">
    <!-- Ambient glowing gradients -->
    <div class="fixed top-0 left-1/4 w-[500px] h-[500px] bg-[#00f0ff]/5 rounded-full blur-[140px] pointer-events-none -z-10"></div>
    <div class="fixed bottom-1/4 right-1/4 w-[600px] h-[600px] bg-[#00ff66]/5 rounded-full blur-[160px] pointer-events-none -z-10"></div>

    <slot />
  </body>
</html>
